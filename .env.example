# Environment Configuration
ENV=development
SEED=42
LOG_LEVEL=INFO

# Compute Hardware Configuration (RTX 4050 Laptop GPU: 6GB VRAM)
# Options: auto | cuda | cpu
DEVICE=auto
MIXED_PRECISION=true
EMBEDDING_BATCH_SIZE=32
TRAINING_BATCH_SIZE=32

# Model Specifications
CODEBERT_MODEL_NAME=microsoft/codebert-base
MAX_TOKEN_LENGTH=512

# Storage & Paths
DATASETS_DIR=./datasets
MODELS_DIR=./saved_models
REPORTS_DIR=./reports

# Database Configuration (SQLite default, ready for PostgreSQL migration)
DATABASE_URL=sqlite:///./backend/database/code_evaluation.db

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Safety Limits for Untrusted Input
MAX_CODE_SIZE_BYTES=50000
AST_PARSING_TIMEOUT_SECONDS=5.0
